# Digital Ghostwriter Slack Bot - Environment Variables
# Copy this file to .env and fill in your actual values

# Slack Credentials
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: Restrict to specific channel
# Leave empty to listen to all channels the bot is invited to
TARGET_CHANNEL_ID=

# Google Gemini API
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Buffer Engine Settings
BUFFER_TIME_WINDOW_MINUTES=30
BUFFER_MIN_MESSAGES=3
BUFFER_MAX_MESSAGES=50
MIN_SIGNAL_SCORE=0.6

# Noise Filtering
MIN_MESSAGE_LENGTH=10

# Database
DB_PATH=data/ghostwriter.db
